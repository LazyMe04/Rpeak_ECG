#!/bin/sh
# The fast half of the gate, before a commit lands.
#
# A commit is the moment a mistake becomes history, and this project has no
# CI: the only thing between an edit and a broken tree is whoever runs the
# gate. So this runs what can finish in seconds -- the language audit, the
# type check and the unit suites -- and leaves the browser smoke suites to
# `npm run gate -- --browser`, because three headless browsers on every commit
# would be a hook people disable.
#
# Install (once per clone):
#   git config core.hooksPath .githooks
#   # or: ln -s ../../.githooks/pre-commit .git/hooks/pre-commit
#
# Bypass, deliberately and visibly:
#   git commit --no-verify
set -e

cd "$(dirname "$0")/../app"

# A Python launcher to use. `python -I` is the right invocation (the pipeline
# reads downloaded files), but a clone may have only `py` or `python3`, and a
# hook that dies on a missing alias is a hook people bypass.
PY=""
for candidate in python py python3; do
  if command -v "$candidate" >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done

echo "pre-commit: i18n audit"
if [ -z "$PY" ]; then
  echo "  SKIPPED: no Python launcher found (python / py / python3)"
elif "$PY" -I -c "" 2>/dev/null; then
  "$PY" -I ../pipeline/check_i18n.py
else
  "$PY" ../pipeline/check_i18n.py
fi

echo "pre-commit: format"
npx prettier --check "src/**/*.{ts,tsx,css}" "scripts/**/*.ts" "*.{ts,js,json,html}" \
  ../README.md "../docs/*.md"

echo "pre-commit: lint"
npx eslint src scripts

echo "pre-commit: typecheck"
npx tsc --noEmit

# Suites that need `data/` print `SKIPPED ...` and exit 0, because the dataset
# is deliberately not in the repository. That is reported here rather than
# counted as a pass: a commit whose only test evidence is skips should say so.
echo "pre-commit: unit suites"
SKIPPED=""
for suite in test test:detect test:hrv test:delineate test:report test:cnn test:i18n; do
  printf "  %-14s " "$suite"
  log="$(mktemp)"
  if npm run --silent "$suite" >"$log" 2>&1; then
    if grep -q '^SKIPPED ' "$log"; then
      echo "skipped (no dataset)"
      SKIPPED="$SKIPPED $suite"
    else
      echo "ok"
    fi
  else
    echo "FAILED"
    tail -20 "$log"
    rm -f "$log"
    exit 1
  fi
  rm -f "$log"
done

if [ -n "$SKIPPED" ]; then
  echo "pre-commit: note -- not checked for want of a dataset:$SKIPPED"
fi

echo "pre-commit: ok (browser suites: npm run gate -- --browser)"
