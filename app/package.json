{
  "name": "rpeak-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"*.{ts,js,json,html}\" ../README.md \"../docs/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"*.{ts,js,json,html}\" ../README.md \"../docs/*.md\"",
    "eval": "tsx scripts/evaluate.ts",
    "eval:quick": "tsx scripts/evaluate.ts --limit 4",
    "test": "tsx scripts/test-shell.ts",
    "test:detect": "tsx scripts/test-detect.ts",
    "test:hrv": "tsx scripts/test-hrv.ts",
    "test:delineate": "tsx scripts/test-delineate.ts",
    "test:report": "tsx scripts/test-report.ts",
    "test:cnn": "tsx scripts/test-cnn.ts",
    "test:i18n": "tsx scripts/test-i18n.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:pages": "tsx scripts/smoke-pages.ts",
    "smoke:app": "tsx scripts/smoke-app.ts",
    "smoke:lang": "tsx scripts/smoke-lang.ts",
    "gate": "tsx scripts/gate.ts",
    "smoke:theme": "tsx scripts/smoke-theme.ts",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "icons": "python scripts/make-icons.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "^8.5.6",
    "prettier": "3.10.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.74.0",
    "vite": "^6.3.5"
  }
}
