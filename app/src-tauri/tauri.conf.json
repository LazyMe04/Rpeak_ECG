{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rpeak",
  "version": "0.1.0",
  "identifier": "com.rpeak.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rpeak",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0b1020"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "ECG monitoring and analysis with AI",
    "longDescription": "A local ECG workstation: replay of Icentia11k segments, R-peak detection, PQRST delineation, HRV, session reports, and a beat classifier that runs entirely on this machine.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
